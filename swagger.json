{
    "openapi": "3.0.0",
    "info": {
        "title": "OTP + User CRUD API",
        "version": "1.0.0",
        "description": "API for OTP-based login (no JWT) and full user CRUD."
    },
    "servers": [
        {
            "url": "http://localhost:5000"
        }
    ],
    "paths": {
        "/api/auth/send-otp": {
            "post": {
                "summary": "Send OTP to mobile",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "mobile": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "mobile"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP sent"
                    },
                    "400": {
                        "description": "Bad request"
                    },
                    "429": {
                        "description": "Rate limited"
                    },
                    "500": {
                        "description": "Server error"
                    }
                }
            }
        },
        "/api/auth/resend-otp": {
            "post": {
                "summary": "Resend OTP (subject to rate limit)",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "mobile": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "mobile"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP resent"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "summary": "Login with mobile + OTP",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "mobile": {
                                        "type": "string"
                                    },
                                    "otp": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "mobile",
                                    "otp"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login success or new user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "type": "object",
                                            "properties": {
                                                "message": {
                                                    "type": "string"
                                                },
                                                "isNewUser": {
                                                    "type": "boolean"
                                                },
                                                "user": {
                                                    "$ref": "#/components/schemas/User"
                                                }
                                            }
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "message": {
                                                    "type": "string"
                                                },
                                                "isNewUser": {
                                                    "type": "boolean"
                                                },
                                                "mobile": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid or expired OTP"
                    },
                    "500": {
                        "description": "Login failed"
                    }
                }
            }
        },
        "/api/auth/verify-otp": {
            "post": {
                "summary": "Verify OTP; returns if profile exists",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "mobile": {
                                        "type": "string"
                                    },
                                    "otp": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "mobile",
                                    "otp"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP verified",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "type": "object",
                                            "properties": {
                                                "message": {
                                                    "type": "string"
                                                },
                                                "isNewUser": {
                                                    "type": "boolean"
                                                },
                                                "user": {
                                                    "$ref": "#/components/schemas/User"
                                                }
                                            }
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "message": {
                                                    "type": "string"
                                                },
                                                "isNewUser": {
                                                    "type": "boolean"
                                                },
                                                "mobile": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid or expired OTP"
                    }
                }
            }
        },
        "/api/auth/create-account": {
            "post": {
                "summary": "Create account after OTP verified",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UserCreate"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Account created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "user": {
                                            "$ref": "#/components/schemas/User"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Phone not verified via OTP"
                    },
                    "400": {
                        "description": "Email/mobile already used"
                    }
                }
            }
        },
        "/api/auth/check-email": {
            "get": {
                "summary": "Check whether email is already used",
                "tags": [
                    "Auth"
                ],
                "parameters": [
                    {
                        "name": "email",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Exists response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "exists": {
                                            "type": "boolean"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/check-mobile": {
            "get": {
                "summary": "Check whether mobile is already used",
                "tags": [
                    "Auth"
                ],
                "parameters": [
                    {
                        "name": "mobile",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Exists response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "exists": {
                                            "type": "boolean"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/login-email": {
            "post": {
                "summary": "Login with email + password",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "isNewUser": {
                                            "type": "boolean"
                                        },
                                        "user": {
                                            "$ref": "#/components/schemas/User"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid email or password"
                    },
                    "500": {
                        "description": "Login failed"
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "summary": "Logout (stateless) - clears latest OTP verification",
                "tags": [
                    "Auth"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "mobile"
                                ],
                                "properties": {
                                    "mobile": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Logged out"
                    }
                }
            }
        },
        "/api/users": {
            "get": {
                "summary": "List users",
                "tags": [
                    "Users"
                ],
                "responses": {
                    "200": {
                        "description": "Array of users"
                    }
                }
            },
            "post": {
                "summary": "Create user (direct create) - can be used by admin",
                "tags": [
                    "Users"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UserCreate"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User created"
                    }
                }
            }
        },
        "/api/users/{id}": {
            "get": {
                "summary": "Get user by id",
                "tags": [
                    "Users"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User"
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            },
            "put": {
                "summary": "Update user",
                "tags": [
                    "Users"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UserUpdate"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Updated"
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            },
            "delete": {
                "summary": "Delete user",
                "tags": [
                    "Users"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Deleted"
                    }
                }
            }
        },
        "/api/foods": {
            "post": {
                "summary": "Create a new food item",
                "tags": [
                    "Foods"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "price": {
                                        "type": "number"
                                    },
                                    "imageUrl": {
                                        "type": "string"
                                    },
                                    "isAvailable": {
                                        "type": "boolean"
                                    }
                                },
                                "required": [
                                    "name",
                                    "price"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Food created"
                    }
                }
            },
            "get": {
                "summary": "List all food items",
                "tags": [
                    "Foods"
                ],
                "responses": {
                    "200": {
                        "description": "Array of food items"
                    }
                }
            }
        },
      "/api/foods/{id}": {
            "get": {
                "summary": "Get food by ID",
                "tags": [
                    "Foods"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Food item"
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            },
            "put": {
                "summary": "Update food by ID",
                "tags": [
                    "Foods"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Food"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Food updated"
                    }
                }
            },
            "delete": {
                "summary": "Delete food by ID",
                "tags": [
                    "Foods"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Deleted"
                    }
                }
            }
        },
        "/api/carts/active/{userId}": {
            "get": {
                "summary": "Get active cart for a user",
                "tags": [
                    "Cart"
                ],
                "parameters": [
                    {
                        "name": "userId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Active cart"
                    }
                }
            }
        },
        "/api/carts/ensure": {
            "post": {
                "summary": "Ensure a user has a cart",
                "tags": [
                    "Cart"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "userId": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "userId"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Cart ensured"
                    }
                }
            }
        },
        "/api/carts/items": {
            "post": {
                "summary": "Add item to cart",
                "tags": [
                    "Cart"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "cartId": {
                                        "type": "string"
                                    },
                                    "foodId": {
                                        "type": "string"
                                    },
                                    "quantity": {
                                        "type": "integer"
                                    }
                                },
                                "required": [
                                    "cartId",
                                    "foodId",
                                    "quantity"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Item added"
                    }
                }
            }
        },
        "/api/carts/items/{id}": {
            "put": {
                "summary": "Update cart item",
                "tags": [
                    "Cart"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "quantity": {
                                        "type": "integer"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Item updated"
                    }
                }
            },
            "delete": {
                "summary": "Remove item from cart",
                "tags": [
                    "Cart"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Item removed"
                    }
                }
            }
        },
        "/api/carts/{cartId}/summary": {
            "get": {
                "summary": "Get cart summary",
                "tags": [
                    "Cart"
                ],
                "parameters": [
                    {
                        "name": "cartId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cart summary"
                    }
                }
            }
        },
        "/api/checkout/proceed": {
            "post": {
                "summary": "Proceed to payment",
                "tags": [
                    "Checkout"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "cartId": {
                                        "type": "string"
                                    },
                                    "paymentMethod": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "cartId",
                                    "paymentMethod"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Payment initiated"
                    }
                }
            }
        },
        "/api/checkout/{orderId}/paid": {
            "post": {
                "summary": "Mark order as paid",
                "tags": [
                    "Checkout"
                ],
                "parameters": [
                    {
                        "name": "orderId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Order marked as paid"
                    }
                }
            }
        },
        "/api/orders/{id}": {
            "get": {
                "summary": "Get order details",
                "tags": [
                    "Checkout"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Order details"
                    }
                }
            }
        },
        "/api/orders/{id}/cancel": {
            "post": {
                "summary": "Cancel an order",
                "tags": [
                    "Checkout"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Order cancelled"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "mobile": {
                        "type": "string"
                    },
                    "birthday": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "anniversary": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "UserCreate": {
                "type": "object",
                "required": [
                    "mobile"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    },
                    "mobile": {
                        "type": "string"
                    },
                    "birthday": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "anniversary": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "UserUpdate": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    },
                    "birthday": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "anniversary": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "Food": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "price": {
                        "type": "number"
                    },
                    "imageUrl": {
                        "type": "string"
                    },
                    "isAvailable": {
                        "type": "boolean"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "OTP and account-related endpoints"
        },
        {
            "name": "Users",
            "description": "User CRUD endpoints"
        },
        {
            "name": "Foods",
            "description": "CRUD operations for Food items"
        },
        {
            "name": "Cart",
            "description": "Cart management"
        },
        {
            "name": "Checkout",
            "description": "Checkout and order management"
        }
    ]
}